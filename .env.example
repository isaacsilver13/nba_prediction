# Reference for local development. This repo is local-only — there is no
# hosted prod environment for it (see PROJECTS.md).
#
# Note: nothing here loads a .env file automatically (no python-dotenv
# dependency) — set these as PowerShell environment variables before running,
# e.g. $env:GROQ_API_KEY='gsk_...', matching `python autorun.py --help`.

# Override default data/output locations (defaults: ./data, ./outputs).
NBA_DATA_DIR=
NBA_OUTPUTS_DIR=

# Required only for the autoresearch loop (python autorun.py --groq / --openai).
# Leave unset to run `python autorun.py --dry-run`, which makes no LLM calls.
GROQ_API_KEY=
OPENAI_API_KEY=

# Required only if autorun.py's workflow pushes results/commits via the GitHub API.
GITHUB_TOKEN=

# Odds collector (normally set as GitHub Actions secrets; locally only for manual --capture runs).
SGO_API_KEY=
THE_ODDS_API_KEY=
